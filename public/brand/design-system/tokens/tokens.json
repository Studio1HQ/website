{
  "$description": "Studio1 design tokens (W3C Design Tokens format). Source of truth: css/tokens.css and tailwind/* mirror these values.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Studio1 Sans",
          "Inter",
          "Arial",
          "sans-serif"
        ],
        "$description": "Studio1 Sans is Inter renamed for Studio1. Inter is the fallback if Studio1 Sans is not loaded."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "System monospace, for code only. Not a brand font."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      }
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "body": {
        "$type": "dimension",
        "$value": "14px"
      },
      "body-lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "subhead": {
        "$type": "dimension",
        "$value": "18px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "24px"
      },
      "title": {
        "$type": "dimension",
        "$value": "32px"
      },
      "display": {
        "$type": "dimension",
        "$value": "48px"
      },
      "hero": {
        "$type": "dimension",
        "$value": "64px"
      },
      "code": {
        "$type": "dimension",
        "$value": "13px"
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.1
      },
      "base": {
        "$type": "number",
        "$value": 1.3
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.55
      }
    },
    "tracking": {
      "tight": {
        "$type": "dimension",
        "$value": "-0.04em"
      },
      "base": {
        "$type": "dimension",
        "$value": "-0.03em"
      },
      "none": {
        "$type": "dimension",
        "$value": "0em"
      },
      "caps": {
        "$type": "dimension",
        "$value": "0.06em"
      }
    }
  },
  "color": {
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "50": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "100": {
        "$type": "color",
        "$value": "#f2f2f2"
      },
      "200": {
        "$type": "color",
        "$value": "#e8e8e8"
      },
      "300": {
        "$type": "color",
        "$value": "#d4d4d4"
      },
      "400": {
        "$type": "color",
        "$value": "#a3a3a3"
      },
      "500": {
        "$type": "color",
        "$value": "#707070"
      },
      "600": {
        "$type": "color",
        "$value": "#525252"
      },
      "700": {
        "$type": "color",
        "$value": "#3a3a3a"
      },
      "800": {
        "$type": "color",
        "$value": "#1f1f1f"
      },
      "900": {
        "$type": "color",
        "$value": "#141414"
      },
      "950": {
        "$type": "color",
        "$value": "#0a0a0a"
      }
    },
    "sky": {
      "50": {
        "$type": "color",
        "$value": "#f0faff"
      },
      "100": {
        "$type": "color",
        "$value": "#ddf4ff"
      },
      "200": {
        "$type": "color",
        "$value": "#b6e3ff"
      },
      "400": {
        "$type": "color",
        "$value": "#58a6ff"
      },
      "600": {
        "$type": "color",
        "$value": "#0969da"
      },
      "800": {
        "$type": "color",
        "$value": "#0a3069"
      }
    },
    "brand": {
      "$description": "Studio1 logo colors, as on studio1hq.com. For the logo mark and brand moments only, never for UI text or controls.",
      "red": {
        "$type": "color",
        "$value": "#fe3c34"
      },
      "orange": {
        "$type": "color",
        "$value": "#fe8b4b"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.brand.red}",
            "position": 0
          },
          {
            "color": "{color.brand.orange}",
            "position": 1
          }
        ],
        "$description": "Left to right (90deg)."
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#1a7f37"
      },
      "success-bg": {
        "$type": "color",
        "$value": "#dafbe1"
      },
      "warning": {
        "$type": "color",
        "$value": "#9a6700"
      },
      "warning-bg": {
        "$type": "color",
        "$value": "#fff8c5"
      },
      "danger": {
        "$type": "color",
        "$value": "#cf222e"
      },
      "danger-bg": {
        "$type": "color",
        "$value": "#ffebe9"
      }
    },
    "semantic-light": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.sky.100}"
      },
      "link": {
        "$type": "color",
        "$value": "{color.sky.600}"
      },
      "inverse-bg": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      },
      "inverse-text": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      }
    },
    "semantic-dark": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.800}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.neutral.600}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.sky.800}"
      },
      "link": {
        "$type": "color",
        "$value": "{color.sky.400}"
      },
      "inverse-bg": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "inverse-text": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "24": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "10px"
    },
    "full": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "shadow": {
    "raised": {
      "$type": "shadow",
      "$value": "0 2px 8px rgba(0, 0, 0, 0.04)"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "0 8px 32px rgba(0, 0, 0, 0.08)"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms"
    }
  }
}
