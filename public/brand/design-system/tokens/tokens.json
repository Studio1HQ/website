{
  "$description": "Studio1 design tokens (W3C Design Tokens format), version 2: the paper design. Source of truth; css/tokens.css and tailwind/* mirror these values.",
  "font": {
    "family": {
      "sans": {
        "$value": ["Studio1 Sans", "Inter", "Arial", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Studio1 Sans is Inter renamed for Studio1. Inter is the fallback and has identical shapes."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"],
        "$type": "fontFamily",
        "$description": "System monospace, for code only. Not a brand font."
      }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight", "$description": "Body text." },
      "medium": { "$value": 500, "$type": "fontWeight", "$description": "Headings, labels, buttons, numbers. The heaviest weight Studio1 uses." }
    },
    "size": {
      "frame": { "$value": "11px", "$type": "dimension", "$description": "Layer labels on selection frames." },
      "caption": { "$value": "12px", "$type": "dimension", "$description": "Captions, metadata, eyebrows." },
      "body-sm": { "$value": "14px", "$type": "dimension", "$description": "Dense product UI: tables, sidebars, menus." },
      "body": { "$value": "16px", "$type": "dimension", "$description": "Default text." },
      "body-lg": { "$value": "18px", "$type": "dimension", "$description": "Lead paragraphs under headlines." },
      "subhead": { "$value": "20px", "$type": "dimension", "$description": "Card titles." },
      "heading": { "$value": "24px", "$type": "dimension", "$description": "Subsections, slide titles." },
      "title": { "$value": "32px", "$type": "dimension", "$description": "Section headings on mobile, page titles." },
      "display": { "$value": "46px", "$type": "dimension", "$description": "Section headings on desktop." },
      "hero": { "$value": "68px", "$type": "dimension", "$description": "Hero headlines. 38px on mobile." },
      "code": { "$value": "13px", "$type": "dimension", "$description": "Inline code and code blocks." }
    },
    "line-height": {
      "tight": { "$value": 1.1, "$type": "number", "$description": "Hero and display headlines." },
      "snug": { "$value": 1.2, "$type": "number", "$description": "Section headings." },
      "base": { "$value": 1.3, "$type": "number", "$description": "UI text, labels, captions." },
      "relaxed": { "$value": 1.6, "$type": "number", "$description": "Body copy and long reads." }
    },
    "tracking": {
      "tight": { "$value": "-0.045em", "$type": "dimension", "$description": "Headlines 24px and up." },
      "base": { "$value": "-0.03em", "$type": "dimension", "$description": "Default for all text." },
      "none": { "$value": "0em", "$type": "dimension", "$description": "Code." },
      "caps": { "$value": "0.1em", "$type": "dimension", "$description": "Uppercase eyebrows and captions." }
    }
  },
  "color": {
    "paper": { "$value": "#f4efe7", "$type": "color", "$description": "Background of almost everything. Also the light text and mark colour on print orange and Night." },
    "ink": { "$value": "#141414", "$type": "color", "$description": "Type, icons, lines, primary buttons." },
    "night": { "$value": "#0d0d0d", "$type": "color", "$description": "Dark bands between paper sections, dark mode background, code blocks." },
    "white": { "$value": "#ffffff", "$type": "color", "$description": "Cards and UI panels sitting on paper." },
    "ink-alpha": {
      "$description": "Ink at reduced opacity, for text and lines on paper. Don't introduce new greys.",
      "70": { "$value": "#141414b3", "$type": "color", "$description": "Secondary text. 6.4:1 on paper." },
      "60": { "$value": "#14141499", "$type": "color", "$description": "Captions and small labels. 4.6:1 on paper; use 70 on the surface colour." },
      "32": { "$value": "#14141452", "$type": "color", "$description": "Faint marks and separators. Not for text." },
      "14": { "$value": "#14141424", "$type": "color", "$description": "Hairlines, borders, dividers." },
      "05": { "$value": "#1414140d", "$type": "color", "$description": "Background grid." }
    },
    "paper-alpha": {
      "$description": "Paper at reduced opacity, for text and lines on Night.",
      "70": { "$value": "#f4efe7b3", "$type": "color", "$description": "Secondary text on Night. 8.5:1." },
      "60": { "$value": "#f4efe799", "$type": "color", "$description": "Captions on Night. 6.5:1." },
      "14": { "$value": "#f4efe724", "$type": "color", "$description": "Hairlines on Night." }
    },
    "neutral": {
      "$description": "Warm neutrals, solid. Prefer ink-alpha for text and lines; use these where a solid colour is needed.",
      "0": { "$value": "#ffffff", "$type": "color" },
      "100": { "$value": "#f4efe7", "$type": "color", "$description": "Paper." },
      "200": { "$value": "#ece6dc", "$type": "color", "$description": "Surface: panels, sidebars, inline code." },
      "300": { "$value": "#ddd5c8", "$type": "color", "$description": "Solid borders where alpha can't be used." },
      "400": { "$value": "#c4bbad", "$type": "color" },
      "500": { "$value": "#8f877b", "$type": "color", "$description": "Decorative only; too light for text." },
      "600": { "$value": "#7a7268", "$type": "color" },
      "700": { "$value": "#5e574e", "$type": "color", "$description": "Solid secondary text." },
      "800": { "$value": "#3a352f", "$type": "color" },
      "900": { "$value": "#141414", "$type": "color", "$description": "Ink." },
      "950": { "$value": "#0d0d0d", "$type": "color", "$description": "Night." }
    },
    "print": {
      "$description": "Print orange and its ramp. 500 is the brand accent; the rest are for charts, shading in illustrations and the swatch strip.",
      "50": { "$value": "#fdf0e4", "$type": "color", "$description": "Soft fill for selected and highlighted states." },
      "200": { "$value": "#fbd9bd", "$type": "color" },
      "300": { "$value": "#f9bb8c", "$type": "color" },
      "400": { "$value": "#f89a5c", "$type": "color" },
      "500": { "$value": "#f97316", "$type": "color", "$description": "The one accent. 2.5:1 on paper: display type (40px+) and shapes only. Ink text on it (6.6:1)." },
      "600": { "$value": "#e2620d", "$type": "color" },
      "700": { "$value": "#c2410c", "$type": "color", "$description": "Orange for small text and link hovers on paper and white. 4.5:1 on paper." },
      "800": { "$value": "#9a3412", "$type": "color" }
    },
    "brand": {
      "$description": "The Studio1 mark's gradient. Only inside the mark.",
      "red": { "$value": "#f97316", "$type": "color" },
      "orange": { "$value": "#f97316", "$type": "color" },
      "gradient": {
        "$value": [
          { "color": "{color.brand.red}", "position": 0 },
          { "color": "{color.brand.orange}", "position": 1 }
        ],
        "$type": "gradient",
        "$description": "Left to right (90deg)."
      }
    },
    "status": {
      "$description": "Product UI only, for real states. Always pair the text colour with its background and a word or icon.",
      "success": { "$value": "#1a7f37", "$type": "color" },
      "success-bg": { "$value": "#dafbe1", "$type": "color" },
      "warning": { "$value": "#9a6700", "$type": "color" },
      "warning-bg": { "$value": "#fff8c5", "$type": "color" },
      "danger": { "$value": "#cf222e", "$type": "color" },
      "danger-bg": { "$value": "#ffebe9", "$type": "color" }
    },
    "semantic-light": {
      "bg": { "$value": "{color.paper}", "$type": "color" },
      "surface": { "$value": "{color.neutral.200}", "$type": "color" },
      "card": { "$value": "{color.white}", "$type": "color" },
      "border": { "$value": "{color.ink-alpha.14}", "$type": "color" },
      "text": { "$value": "{color.ink}", "$type": "color" },
      "text-secondary": { "$value": "{color.ink-alpha.70}", "$type": "color" },
      "text-muted": { "$value": "{color.ink-alpha.60}", "$type": "color" },
      "accent": { "$value": "{color.print.500}", "$type": "color" },
      "on-accent": { "$value": "{color.ink}", "$type": "color" },
      "accent-soft": { "$value": "{color.print.50}", "$type": "color" },
      "link": { "$value": "{color.ink}", "$type": "color" },
      "link-hover": { "$value": "{color.print.700}", "$type": "color" },
      "focus": { "$value": "{color.ink}", "$type": "color" },
      "inverse-bg": { "$value": "{color.ink}", "$type": "color" },
      "inverse-text": { "$value": "{color.paper}", "$type": "color" }
    },
    "semantic-dark": {
      "bg": { "$value": "{color.night}", "$type": "color" },
      "surface": { "$value": "#1b1b1a", "$type": "color", "$description": "Paper at 6% over Night." },
      "card": { "$value": "{color.ink}", "$type": "color" },
      "border": { "$value": "{color.paper-alpha.14}", "$type": "color" },
      "text": { "$value": "{color.paper}", "$type": "color" },
      "text-secondary": { "$value": "{color.paper-alpha.70}", "$type": "color" },
      "text-muted": { "$value": "{color.paper-alpha.60}", "$type": "color" },
      "accent": { "$value": "{color.print.500}", "$type": "color", "$description": "6.9:1 on Night, so it works as text here." },
      "on-accent": { "$value": "{color.ink}", "$type": "color" },
      "accent-soft": { "$value": "#3a2416", "$type": "color", "$description": "Print orange at 18% over Night." },
      "link": { "$value": "{color.paper}", "$type": "color" },
      "link-hover": { "$value": "{color.print.500}", "$type": "color" },
      "focus": { "$value": "{color.paper}", "$type": "color" },
      "inverse-bg": { "$value": "{color.paper}", "$type": "color" },
      "inverse-text": { "$value": "{color.ink}", "$type": "color" }
    }
  },
  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension", "$description": "Selection frames, block prints, images, stat cards, tags and labels." },
    "sm": { "$value": "4px", "$type": "dimension", "$description": "Inline code." },
    "md": { "$value": "6px", "$type": "dimension", "$description": "Cards, tiles, inputs, the nav bar." },
    "full": { "$value": "999px", "$type": "dimension", "$description": "Buttons, avatars, status dots." }
  },
  "border": {
    "width": { "$value": "1px", "$type": "dimension", "$description": "Hairlines and card borders." },
    "frame": { "$value": "1.5px", "$type": "dimension", "$description": "Selection frames and outline buttons." }
  },
  "shadow": {
    "card": { "$value": "0 1px 0 rgba(27, 23, 20, 0.06)", "$type": "shadow", "$description": "White cards on paper." },
    "raised": { "$value": "0 8px 30px -10px rgba(0, 0, 0, 0.12)", "$type": "shadow", "$description": "Cards on hover, menus." },
    "print": { "$value": "0 30px 60px -30px rgba(90, 30, 0, 0.55)", "$type": "shadow", "$description": "White cards floating on the print panel (blog covers)." }
  },
  "motion": {
    "ease": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier", "$description": "Every transition." },
    "fast": { "$value": "300ms", "$type": "duration", "$description": "Hovers." },
    "base": { "$value": "500ms", "$type": "duration", "$description": "State changes, small moves." },
    "slow": { "$value": "900ms", "$type": "duration", "$description": "Section entrances." },
    "reveal": { "$value": "1200ms", "$type": "duration", "$description": "Headline line reveals, staggered 120ms." }
  }
}
