{
  "manifest_version": 3,
  "name": "Studio1 Connect",
  "short_name": "Connect",
  "version": "1.2.1",
  "description": "Your Studio1 tasks, day clock and notifications, from the browser toolbar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Studio1 Connect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.studio1hq.com/*",
        "http://dashboard.localhost/*"
      ],
      "js": [
        "detect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://dashboard.studio1hq.com/*",
    "http://dashboard.localhost:3000/*",
    "http://localhost:3000/*"
  ]
}
