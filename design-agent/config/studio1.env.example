# Studio1 model setup: Claude Opus 5.5 leads, open models on Nebius Token Factory help.
# Paste this block into .env (or run each line through `uv run design-agent config set`) and fill in
# the two keys. Nebius serves an OpenAI-compatible API, so each Nebius model is written
# `openai:<nebius model id>` and sent to the Nebius base URL with the key that
# DESIGN_AGENT_<ROLE>_MODEL_API_KEY_ENV names (the name of the variable, never the key itself).
#
# Why the VISION flags: the harness has no capability data for these models, so a role that looks
# at images runs with a warning and doctor shows it as unverified until the flag is set to 1.
# They take images per the provider's model list; recheck that page before relying on it.
# The tool selector and learning roles never look at images, so they need no flag.
#
# Costs are estimated from config/prices.toml, which lists the three Nebius models.

# Keys
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=

# Lead: Claude Opus 5.5 on Anthropic (the default; written out so the file is complete)
DESIGN_AGENT_MODEL=anthropic:claude-opus-5-5
DESIGN_AGENT_MODEL_EFFORT=high

# Helpers (builders, critics, renders): Kimi K3.1 Pro on Nebius
DESIGN_AGENT_HELPER_MODEL=openai:moonshotai/Kimi-K3.1-Pro
DESIGN_AGENT_HELPER_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
DESIGN_AGENT_HELPER_MODEL_API_KEY_ENV=NEBIUS_API_KEY
DESIGN_AGENT_HELPER_MODEL_VISION=1

# look (inspects renders, needs image input): Qwen3.8 27B on Nebius
DESIGN_AGENT_LOOK_MODEL=openai:Qwen/Qwen3.8-27B
DESIGN_AGENT_LOOK_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
DESIGN_AGENT_LOOK_MODEL_API_KEY_ENV=NEBIUS_API_KEY
DESIGN_AGENT_LOOK_MODEL_VISION=1

# Tool selector (picks MCP tools): GLM 5.3 Flash on Nebius
DESIGN_AGENT_TOOL_SELECTOR_MODEL=openai:zai-org/GLM-5.3-Flash
DESIGN_AGENT_TOOL_SELECTOR_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
DESIGN_AGENT_TOOL_SELECTOR_MODEL_API_KEY_ENV=NEBIUS_API_KEY

# Learning (post-job review): the same GLM model
DESIGN_AGENT_LEARNING_MODEL=openai:zai-org/GLM-5.3-Flash
DESIGN_AGENT_LEARNING_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
DESIGN_AGENT_LEARNING_MODEL_API_KEY_ENV=NEBIUS_API_KEY

# Web search through MCP (config/mcp.studio1.example.toml) reads its header from the shell
# environment, not from .env: export OLOSTEP_MCP_AUTHORIZATION="Bearer <key>" before you run.
