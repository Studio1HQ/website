GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CMS_SITE_URL=https://www.studio1hq.com
GITHUB_OAUTH_SCOPE=public_repo

# Supabase: stores hackathon registrations, job applications and DevRel
# Cohort applications. Server-only; never prefix these with NEXT_PUBLIC_.
# Tables, setup and filtering: supabase/README.md. With these unset, careers
# and the cohort page keep "Apply by email" and hackathon registration returns
# 503 in production (logs to the console in development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Internal dashboard (/internal): job applications, hackathon registrations,
# cohort applications and the mailing lists, for @studio1hq.com staff only.
# Sign-in is a Supabase Auth magic link, so it needs only the two Supabase
# variables above, plus setup in the Supabase dashboard (supabase/README.md).
# Optional: INTERNAL_AUTH_SECRET (32+ random characters) signs dashboard
# sessions instead of a key derived from SUPABASE_SERVICE_ROLE_KEY; change it
# to sign everyone out.
INTERNAL_AUTH_SECRET=
# Email through Resend (lib/mailer.ts): applicant emails from the dashboard
# and the forms' automatic confirmations. Without a key, the dashboard opens
# emails in your mail app and confirmations are skipped. Domains verified in
# Resend: careers.studio1hq.com (jobs), hackathons.studio1hq.com, and
# studio1hq.com, the fallback for the cohort and for any subdomain that isn't
# verified yet. Give the API key sending access to all domains.
RESEND_API_KEY=
# Signing secret (whsec_…) of the Resend webhook that points at
# /api/resend/webhook: delivery states on the dashboard, and addresses that
# bounce or complain stop getting emails. Without it the endpoint answers 503.
RESEND_WEBHOOK_SECRET=
# Optional sender overrides; leave empty for the defaults in lib/mailer.ts.
# EMAIL_FROM is the fallback (default "Studio1 <contact@studio1hq.com>").
EMAIL_FROM=
EMAIL_FROM_JOBS=
EMAIL_FROM_HACKATHONS=
EMAIL_FROM_COHORT=
# Local development only: skip sign-in on `next dev` at localhost and act as
# this @studio1hq.com address (saves still write to the live Supabase data).
# Ignored in production builds. `next dev` also listens on your network, so
# run `pnpm dev -H localhost` on shared Wi-Fi.
INTERNAL_DEV_BYPASS=

# AI agent markdown (app/ai-md, lib/ai-agents.ts). Optional block of markdown
# added near the top of every page that AI agents read; leave unset to serve
# the markdown without it. Write "\n" for line breaks. Keep the text in Vercel,
# not in this public repo.
AI_OFFER_MARKDOWN=

# Blog publishing from the dashboard (app/internal/(dashboard)/blog,
# lib/internal/blog/github.ts). Publish commits the post and its images to
# this repo's branch, and Vercel deploys it. Use a fine-grained token limited
# to the one repo with "Contents: Read and write" and nothing else. Without
# it, writing and reviewing work and the Publish button stays off.
GITHUB_TOKEN=
# Optional: defaults are Studio1HQ/website and main.
GITHUB_REPO=
GITHUB_BRANCH=
