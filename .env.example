GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CMS_SITE_URL=https://www.studio1hq.com
GITHUB_OAUTH_SCOPE=public_repo

# Supabase: stores hackathon registrations, job applications and DevRel
# Cohort applications. Server-only; never prefix these with NEXT_PUBLIC_.
# Tables, setup and filtering: supabase/README.md. With these unset, careers
# and the cohort page keep "Apply by email" and hackathon registration returns
# 503 in production (logs to the console in development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI agent markdown (app/ai-md, lib/ai-agents.ts). Optional block of markdown
# added near the top of every page that AI agents read; leave unset to serve
# the markdown without it. Write "\n" for line breaks. Keep the text in Vercel,
# not in this public repo.
AI_OFFER_MARKDOWN=
